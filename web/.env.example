# ZenFlow AI — environment
#
# Copy to .env.local for development.

# The form-checking backend. Both the REST base and the WebSocket base are
# derived from this single value (https:// -> wss://, http:// -> ws://), so
# there is only ever one URL to change.
#
#   local dev   http://localhost:8000
#   production  https://exercise-form-backend.onrender.com
NEXT_PUBLIC_FORM_COACH_URL=https://exercise-form-backend.onrender.com

# Optional overrides. Leave unset to use the self-hosted copies that
# `npm run assets` places in public/ — that is the supported path.
# NEXT_PUBLIC_MEDIAPIPE_MODEL_PATH=/models/pose_landmarker_lite.task
# NEXT_PUBLIC_MEDIAPIPE_WASM_PATH=/mediapipe/wasm
